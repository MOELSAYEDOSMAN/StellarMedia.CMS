data/db.corrupt-*.json

# uploaded media (keep the folder, ignore the files)
public/uploads/*
!public/uploads/.gitkeep

# misc
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.vercel/
.turbo/
*.tsbuildinfo
