    "about": {
      "id": "e806f700-86ae-40cf-8aa5-4dc573e15325",
      "eyebrow": "About",
      "heading": "Creative work that holds up in a boardroom and on a billboard.",
      "body": "Stellar Media is a marketing and creative agency based in Abu Dhabi. We work with government entities and major brands that need communication to be clear, consistent and well made.",
      "principles": [
        {
          "id": "babf3695-7237-4390-81ed-db163a778194",
          "title": "Clear before clever",
          "text": "Every campaign starts with one idea that your audience can repeat back."
        },
        {
          "id": "59c8b983-c4d9-430b-8012-6d7dbfe4c762",
          "title": "Built for scale",
          "text": "Identities and content systems that stay consistent across channels and teams."
        },
        {
          "id": "b0a08e26-deb1-4bbc-8bbf-c441c12971f0",
          "title": "Made with care",
          "text": "Craft in the details, from copy to colour to the final export."
        }
      ],
      "visible": true,
      "order": 1
    },
    "services": {
      "id": "3f857cc7-7292-42cc-99d8-0c2d42061436",
      "eyebrow": "Services",
      "heading": "Everything a campaign needs, under one roof.",
      "items": [
        {
          "id": "9d09048a-5a20-4a01-99d6-67b9e749baa3",
          "name": "Strategy",
          "summary": "We define the audience, the message and the channels before any design starts.",
          "points": [
            "Brand positioning",
            "Audience research",
            "Campaign planning"
          ]
        },
        {
          "id": "6882ae61-8dce-44b9-8819-7116078c1da4",
          "name": "Branding",
          "summary": "Visual and verbal identities built to work in print, digital and physical spaces.",
          "points": [
            "Identity design",
            "Guidelines",
            "Naming and tone of voice"
          ]
        },
        {
          "id": "ae98bff9-cd07-44e3-af98-f5197a7f40bf",
          "name": "Content",
          "summary": "Copy, photography and video that explain your story in plain, memorable language.",
          "points": [
            "Copywriting",
            "Social content",
            "Editorial"
          ]
        },
        {
          "id": "a9451792-49e7-4a71-aec2-e189117db602",
          "name": "Digital marketing",
          "summary": "Campaigns planned, launched and measured across the channels that matter to your audience.",
          "points": [
            "Social media",
            "Paid media",
            "Web and landing pages"
          ]
        },
        {
          "id": "faf02a30-fd85-487f-8a45-9108bc1490aa",
          "name": "Creative production",
          "summary": "From storyboard to final delivery, we produce the assets your campaign needs.",
          "points": [
            "Video",
            "Motion graphics",
            "Print and events"
          ]
        }
      ],
      "visible": true,
      "order": 2
    },
